# LiveKit Cloud (required by FDB-v3 inference)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs hosted speech. Register the key name for the official re-run.
ELEVEN_API_KEY=

# Official Full-Duplex-Bench checkout and data
INTERRA_FDB_V3_ROOT=.runtime/Full-Duplex-Bench/v3
INTERRA_FDB_DATA_ROOT=.runtime/Full-Duplex-Bench/v3/fdb_v3_data_released

# Local reasoning model. Ollama must expose its OpenAI-compatible endpoint.
INTERRA_FDB_LLM_MODEL=qwen3:8b
INTERRA_OLLAMA_OPENAI_URL=http://localhost:11434/v1

# Explicit, reproducible speech configuration
INTERRA_ELEVEN_STT_MODEL=scribe_v2_realtime
INTERRA_ELEVEN_TTS_MODEL=eleven_turbo_v2_5
INTERRA_ELEVEN_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
INTERRA_FDB_LATENCY_PROFILE=instant
INTERRA_FDB_TRACE_DIR=artifacts/fdb_v3
